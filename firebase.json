{
    "flutter":  {
                    "platforms":  {
                                      "android":  {
                                                      "default":  {
                                                                      "projectId":  "myheritage-4fe2f",
                                                                      "appId":  "1:83101076806:android:29f95de6243c444260a947",
                                                                      "fileOutput":  "android/app/google-services.json"
                                                                  }
                                                  },
                                      "dart":  {
                                                   "lib/firebase_options.dart":  {
                                                                                     "projectId":  "myheritage-4fe2f",
                                                                                     "configurations":  {
                                                                                                            "android":  "1:83101076806:android:29f95de6243c444260a947",
                                                                                                            "web":  "1:83101076806:web:5665c75a161dc8c860a947"
                                                                                                        }
                                                                                 }
                                               }
                                  }
                },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firebase_rules/safety_module.indexes.json"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "daily-planner"
        },
        {
            "source": "functions-safety",
            "codebase": "safety"
        }
    ],
    "hosting":  {
                    "public":  "build/web",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "headers":  [
                                   {
                                       "source": "**",
                                       "headers": [
                                           {
                                               "key": "Cache-Control",
                                               "value": "no-cache, no-store, must-revalidate"
                                           }
                                       ]
                                   }
                               ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ]
                }
}
