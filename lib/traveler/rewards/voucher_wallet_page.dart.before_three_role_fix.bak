part of '../traveler_pages.dart';

class VoucherWalletPage extends StatelessWidget {
  const VoucherWalletPage({super.key});

  @override
  Widget build(BuildContext context) {
    final uid = AppServices.auth.currentUser!.uid;
    return Scaffold(
      appBar: AppBar(title: const Text('Voucher Wallet')),
      body: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
        stream: AppServices.db.collection('claimed_vouchers').where('userId', isEqualTo: uid).snapshots(),
        builder: (context, snapshot) {
          if (!snapshot.hasData) return const Center(child: CircularProgressIndicator());
          final docs = snapshot.data!.docs.toList()..sort((a, b) => (asDate(b.data()['claimedAt']) ?? DateTime(2000)).compareTo(asDate(a.data()['claimedAt']) ?? DateTime(2000)));
          if (docs.isEmpty) return emptyState('No claimed vouchers');
          return ListView.separated(
            padding: const EdgeInsets.all(16),
            itemCount: docs.length,
            separatorBuilder: (_, __) => const SizedBox(height: 10),
            itemBuilder: (context, index) {
              final doc = docs[index];
              final claim = doc.data();
              return Card(
                child: ExpansionTile(
                  title: Text(claim['title'] ?? 'Voucher'),
                  subtitle: Text(
                    '${claim['vendorName'] ?? 'Registered vendor'} • '
                    '${claim['status'] ?? ''} • ${claim['pointCost'] ?? 0} points',
                  ),
                  children: [
                    if (claim['status'] == 'claimed') ...[
                      const Text('Show this QR code to the vendor.'),
                      const SizedBox(height: 10),
                      QrImageView(data: '${doc.id}|${claim['token']}', size: 220),
                      const SizedBox(height: 14),
                    ] else
                      const Padding(padding: EdgeInsets.all(18), child: Text('This voucher has already been redeemed.')),
                  ],
                ),
              );
            },
          );
        },
      ),
    );
  }
}


