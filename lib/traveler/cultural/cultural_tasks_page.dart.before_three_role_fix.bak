part of '../traveler_pages.dart';

class CulturalTasksPage extends StatefulWidget {
  const CulturalTasksPage({
    super.key,
    this.initialTaskId,
    this.vendorId,
  });

  final String? initialTaskId;
  final String? vendorId;

  @override
  State<CulturalTasksPage> createState() =>
      _CulturalTasksPageState();
}

class _CulturalTasksPageState
    extends State<CulturalTasksPage> {
  static const categories = [
    'All',
    'Heritage & History',
    'Food Heritage',
    'Traditional Craft',
    'Arts & Performance',
    'Nature & Conservation',
    'Community & Local Business',
  ];

  String selectedCategory = 'All';

  IconData _categoryIcon(String category) {
    return switch (category) {
      'Heritage & History' => Icons.account_balance_outlined,
      'Food Heritage' => Icons.restaurant_outlined,
      'Traditional Craft' => Icons.handyman_outlined,
      'Arts & Performance' => Icons.palette_outlined,
      'Nature & Conservation' => Icons.eco_outlined,
      _ => Icons.storefront_outlined,
    };
  }

  Future<void> submit(
    BuildContext context,
    String taskId,
    Map<String, dynamic> task,
  ) async {
    final uid = AppServices.auth.currentUser!.uid;

    final existing = await AppServices.db
        .collection('task_submissions')
        .where('userId', isEqualTo: uid)
        .where('taskId', isEqualTo: taskId)
        .limit(1)
        .get();

    if (existing.docs.isNotEmpty) {
      showMessage(
        context,
        'You already submitted this optional task.',
        error: true,
      );
      return;
    }

    final image = await ImagePicker().pickImage(
      source: ImageSource.camera,
      imageQuality: 80,
    );

    if (image == null) return;

    showMessage(context, 'Uploading task evidence...');

    try {
      final url = await AppServices.uploadImage(
        folder: 'cultural_submissions',
        uid: uid,
        bytes: await image.readAsBytes(),
        extension: image.name.split('.').last,
      );

      await AppServices.db
          .collection('task_submissions')
          .add({
        'taskId': taskId,
        'taskTitle': task['title'],
        'taskCategory': task['category'],
        'taskType': task['taskType'],
        'userId': uid,
        'vendorId': task['vendorId'],
        'vendorName': task['vendorName'],
        'placeId': task['placeId'],
        'imageUrl': url,
        'expectedCategory':
            task['requiredPhotoCategory'],
        'evidenceType':
            task['evidenceType'] ?? 'photo',
        'aiResult': 'manual_admin_verification',
        'confidence': 0,
        'status': 'pending',
        'rewardPoints': task['rewardPoints'] ?? 0,
        'submittedAt': FieldValue.serverTimestamp(),
      });

      if (context.mounted) {
        showMessage(
          context,
          'Task submitted. Points will be added after administrator approval.',
        );
      }
    } catch (error) {
      if (context.mounted) {
        showMessage(
          context,
          error.toString(),
          error: true,
        );
      }
    }
  }

  LatLng? _coordinates(Map<String, dynamic> task) {
    final raw = task['location'];

    if (raw is GeoPoint) {
      return LatLng(raw.latitude, raw.longitude);
    }

    if (raw is Map) {
      final map = Map<String, dynamic>.from(raw);
      final latitude = map['latitude'] ?? map['lat'];
      final longitude =
          map['longitude'] ?? map['lng'] ?? map['lon'];

      if (latitude is num && longitude is num) {
        return LatLng(
          latitude.toDouble(),
          longitude.toDouble(),
        );
      }
    }

    return null;
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar:
          AppBar(title: const Text('Optional Cultural Tasks')),
      body: StreamBuilder<
          QuerySnapshot<Map<String, dynamic>>>(
        stream: AppServices.db
            .collection('cultural_tasks')
            .where('status', isEqualTo: 'active')
            .snapshots(),
        builder: (context, snapshot) {
          if (!snapshot.hasData) {
            return const Center(
              child: CircularProgressIndicator(),
            );
          }

          final allDocs = snapshot.data!.docs.where((doc) {
            final data = doc.data();
            final deadline = asDate(data['deadline']);

            if (deadline != null &&
                deadline.isBefore(DateTime.now())) {
              return false;
            }

            if (widget.vendorId != null &&
                widget.vendorId!.isNotEmpty &&
                '${data['vendorId'] ?? ''}' !=
                    widget.vendorId) {
              return false;
            }

            return true;
          }).toList();

          final docs = allDocs.where((doc) {
            if (selectedCategory == 'All') return true;
            return '${doc.data()['category'] ?? ''}' ==
                selectedCategory;
          }).toList()
            ..sort((first, second) {
              if (first.id == widget.initialTaskId) return -1;
              if (second.id == widget.initialTaskId) return 1;

              final categoryComparison =
                  '${first.data()['category'] ?? ''}'
                      .compareTo(
                '${second.data()['category'] ?? ''}',
              );

              if (categoryComparison != 0) {
                return categoryComparison;
              }

              return '${first.data()['title'] ?? ''}'
                  .compareTo(
                '${second.data()['title'] ?? ''}',
              );
            });

          if (allDocs.isEmpty) {
            return emptyState('No active cultural tasks');
          }

          return Column(
            children: [
              SizedBox(
                height: 58,
                child: ListView.separated(
                  padding:
                      const EdgeInsets.fromLTRB(16, 10, 16, 8),
                  scrollDirection: Axis.horizontal,
                  itemCount: categories.length,
                  separatorBuilder: (_, __) =>
                      const SizedBox(width: 8),
                  itemBuilder: (context, index) {
                    final category = categories[index];

                    return ChoiceChip(
                      selected:
                          selectedCategory == category,
                      label: Text(category),
                      onSelected: (_) => setState(
                        () => selectedCategory = category,
                      ),
                    );
                  },
                ),
              ),
              Expanded(
                child: docs.isEmpty
                    ? emptyState(
                        'No tasks in this category',
                        'Choose another cultural-task category.',
                      )
                    : ListView.separated(
                        padding: const EdgeInsets.all(16),
                        itemCount: docs.length,
                        separatorBuilder: (_, __) =>
                            const SizedBox(height: 10),
                        itemBuilder: (context, index) {
                          final doc = docs[index];
                          final task = doc.data();
                          final point = _coordinates(task);
                          final category =
                              '${task['category'] ?? 'Community & Local Business'}';
                          final taskType =
                              '${task['taskType'] ?? 'Cultural discovery'}';
                          final difficulty =
                              '${task['difficulty'] ?? 'Easy'}';

                          return Card(
                            child: Padding(
                              padding: const EdgeInsets.all(16),
                              child: Column(
                                crossAxisAlignment:
                                    CrossAxisAlignment.start,
                                children: [
                                  Row(
                                    crossAxisAlignment:
                                        CrossAxisAlignment.start,
                                    children: [
                                      CircleAvatar(
                                        child: Icon(
                                          _categoryIcon(category),
                                        ),
                                      ),
                                      const SizedBox(width: 12),
                                      Expanded(
                                        child: Column(
                                          crossAxisAlignment:
                                              CrossAxisAlignment.start,
                                          children: [
                                            Text(
                                              '${task['title'] ?? ''}',
                                              style:
                                                  const TextStyle(
                                                fontSize: 19,
                                                fontWeight:
                                                    FontWeight.bold,
                                              ),
                                            ),
                                            const SizedBox(height: 4),
                                            Wrap(
                                              spacing: 7,
                                              runSpacing: 7,
                                              children: [
                                                Chip(
                                                  label:
                                                      Text(category),
                                                ),
                                                Chip(
                                                  label:
                                                      Text(taskType),
                                                ),
                                                Chip(
                                                  label: Text(
                                                    '$difficulty difficulty',
                                                  ),
                                                ),
                                              ],
                                            ),
                                          ],
                                        ),
                                      ),
                                      Chip(
                                        label: Text(
                                          '+${task['rewardPoints'] ?? 0} pts',
                                        ),
                                      ),
                                    ],
                                  ),
                                  const SizedBox(height: 8),
                                  Text(
                                    'Vendor: '
                                    '${task['vendorName'] ?? task['locationName'] ?? ''}',
                                    style: const TextStyle(
                                      fontWeight:
                                          FontWeight.w600,
                                    ),
                                  ),
                                  const SizedBox(height: 8),
                                  Text(
                                    '${task['description'] ?? ''}',
                                  ),
                                  if ('${task['learningOutcome'] ?? ''}'
                                      .isNotEmpty) ...[
                                    const SizedBox(height: 8),
                                    Text(
                                      'Learning goal: '
                                      '${task['learningOutcome']}',
                                    ),
                                  ],
                                  const SizedBox(height: 8),
                                  Text(
                                    'Required evidence: '
                                    '${task['requiredPhotoCategory'] ?? 'Cultural evidence photo'}',
                                  ),
                                  const SizedBox(height: 6),
                                  const Text(
                                    'Optional: points are awarded only after administrator approval and can be used to claim vendor vouchers.',
                                    style: TextStyle(fontSize: 11),
                                  ),
                                  if (asDate(task['deadline']) !=
                                      null)
                                    Text(
                                      'Deadline: '
                                      '${DateFormat.yMMMd().format(asDate(task['deadline'])!)}',
                                    ),
                                  const SizedBox(height: 14),
                                  Wrap(
                                    spacing: 8,
                                    runSpacing: 8,
                                    children: [
                                      ElevatedButton.icon(
                                        onPressed: () => submit(
                                          context,
                                          doc.id,
                                          task,
                                        ),
                                        icon: const Icon(
                                          Icons
                                              .camera_alt_outlined,
                                        ),
                                        label: const Text(
                                          'Complete with Photo',
                                        ),
                                      ),
                                      if (point != null)
                                        OutlinedButton.icon(
                                          onPressed: () =>
                                              showModalBottomSheet<
                                                  void>(
                                            context: context,
                                            isScrollControlled:
                                                true,
                                            builder: (_) =>
                                                SizedBox(
                                              height:
                                                  MediaQuery.sizeOf(
                                                        context,
                                                      ).height *
                                                      .62,
                                              child: GoogleMap(
                                                initialCameraPosition:
                                                    CameraPosition(
                                                  target: point,
                                                  zoom: 16,
                                                ),
                                                markers: {
                                                  Marker(
                                                    markerId:
                                                        MarkerId(
                                                      doc.id,
                                                    ),
                                                    position:
                                                        point,
                                                    infoWindow:
                                                        InfoWindow(
                                                      title:
                                                          '${task['vendorName'] ?? task['locationName'] ?? ''}',
                                                    ),
                                                  ),
                                                },
                                              ),
                                            ),
                                          ),
                                          icon: const Icon(
                                            Icons.map_outlined,
                                          ),
                                          label:
                                              const Text('View Map'),
                                        ),
                                    ],
                                  ),
                                ],
                              ),
                            ),
                          );
                        },
                      ),
              ),
            ],
          );
        },
      ),
    );
  }
}
